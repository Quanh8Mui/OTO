%% Phân rã chức năng — Mindmap (một trang tổng quan)
%% Nếu draw.io lỗi mindmap, dùng file OTO-FRD-tree.mermaid

mindmap
  root((Garage OTO))
    Khách hàng
      Đặt lịch online
      Lịch sử xe
      Trạng thái sửa chữa
      Báo giá & duyệt
      Thanh toán
      Đánh giá
    Nhân viên
      Tiếp nhận xe
      Lập báo giá
      Cập nhật tiến độ
      Phiếu lĩnh kho
      Hoàn thành & bàn giao
      Lịch làm việc
    Admin
      CRUD nhân viên
      Kho phụ tùng
      Danh mục dịch vụ & giá
      Dashboard
      Báo cáo doanh thu
      Cấu hình thông báo
    Nền tảng
      Đăng ký / Đăng nhập / JWT
      REST API + Role
      PostgreSQL + Flyway
