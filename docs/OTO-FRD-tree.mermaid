%% Biểu đồ phân rã chức năng (Functional Decomposition — dạng cây số thứ tự WBS)
%% Dán vào diagrams.net: Insert → Advanced → Mermaid

flowchart TB
  subgraph L0["Mức 0 — Ngữ cảnh"]
    S((HỆ THỐNG<br/>Quản lý garage ô tô OTO))
  end

  subgraph L1["Mức 1 — Khối chức năng chính"]
    C1[UC-1 Khách hàng]
    C2[UC-2 Nhân viên xưởng]
    C3[UC-3 Quản trị]
    C4[UC-4 Nền tảng & quản lý dữ liệu]
  end

  S --> C1
  S --> C2
  S --> C3
  S --> C4

  subgraph L2A["UC-1 — Chi tiết"]
    A1[F1.1 Đặt lịch bảo dưỡng/sửa chữa online]
    A2[F1.2 Xem lịch sử xe / service history]
    A3[F1.3 Theo dõi trạng thái xe đang sửa]
    A4[F1.4 Xem & duyệt báo giá online]
    A5[F1.5 Thanh toán online]
    A6[F1.6 Đánh giá dịch vụ]
  end
  C1 --> A1
  C1 --> A2
  C1 --> A3
  C1 --> A4
  C1 --> A5
  C1 --> A6

  subgraph L2B["UC-2 — Chi tiết"]
    B1[F2.1 Tiếp nhận xe & ghi nhận tình trạng]
    B2[F2.2 Lập báo giá: phụ tùng + công]
    B3[F2.3 Cập nhật tiến độ sửa chữa]
    B4[F2.4 Yêu cầu phụ tùng từ kho]
    B5[F2.5 Hoàn thành & bàn giao xe]
    B6[F2.6 Xem lịch làm việc]
  end
  C2 --> B1
  C2 --> B2
  C2 --> B3
  C2 --> B4
  C2 --> B5
  C2 --> B6

  subgraph L2C["UC-3 — Chi tiết"]
    K1[F3.1 Quản lý nhân viên CRUD]
    K2[F3.2 Quản lý kho phụ tùng]
    K3[F3.3 Quản lý danh mục dịch vụ và giá]
    K4[F3.4 Dashboard tổng quan]
    K5[F3.5 Báo cáo doanh thu]
    K6[F3.6 Cấu hình thông báo tự động]
  end
  C3 --> K1
  C3 --> K2
  C3 --> K3
  C3 --> K4
  C3 --> K5
  C3 --> K6

  subgraph L2D["UC-4 — Chi tiết"]
    N1[F4.1 Quản trị người dùng & JWT Auth]
    N2[F4.2 REST API nhất quán + phân quyền role]
    N3[F4.3 PostgreSQL + migration schema]
    N4[F4.4 Dịch vụ nghiệp vụ + validation]
  end
  C4 --> N1
  C4 --> N2
  C4 --> N3
  C4 --> N4

  style S fill:#ffd966,stroke:#d6b656
  style C1 fill:#dae8fc
  style C2 fill:#fff2cc
  style C3 fill:#f8cecc
  style C4 fill:#e1d5e7
